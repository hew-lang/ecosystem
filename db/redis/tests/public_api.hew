import std.testing;

import hew.db.redis;

fn error_variants_return_exact_diagnostics() {
    testing.assert_eq_str(redis.error_message(redis.RedisError.Closed("closed")), "closed");
    testing.assert_eq_str(redis.error_message(redis.RedisError.Timeout("late")), "late");
    testing.assert_eq_str(redis.error_message(redis.RedisError.InvalidInput("invalid")), "invalid");
}

fn unavailable_connection_returns_typed_error() {
    let client = spawn redis.Conn(options: Options { url: "redis://127.0.0.1:1/" });
    match await client.get("key") {
        .Ok(result) => match result {
            .Ok(_) => testing.assert_true(false),
            .Err(error) => testing.assert_true(!redis.error_message(error).is_empty()),
        },
        .Err(_) => testing.assert_true(false),
    }
}

fn main() {
    error_variants_return_exact_diagnostics();
    unavailable_connection_returns_typed_error();
}
