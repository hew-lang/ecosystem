//! Service-backed public API coverage. CI provides Redis on 127.0.0.1:6379.

import hew.db.redis;

extern "C" {
    fn hew_redis_connection_count() -> i64;
}

fn binary(text: string) -> bytes {
    text.to_bytes()
}

fn unicode_key() -> string {
    "hew:redis:beta:unicode:clé-de-données-日本語"
}

fn unicode_field() -> string {
    "champ-de-données-測試"
}

fn unicode_value() -> bytes {
    "Requêtes traitées — 雪の結晶".to_bytes()
}

fn nul_value() -> bytes {
    var value: bytes = bytes.new();
    value.push(65);
    value.push(0);
    value.push(66);
    value
}

fn assert_bytes(actual: bytes, expected: bytes) {
    assert(actual.len() == expected.len());
    for i in 0..expected.len() {
        match actual.get(i) {
            .Some(left) => match expected.get(i) {
                .Some(right) => assert(left as i64 == right as i64),
                .None => assert(false),
            }
            .None => assert(false),
        }
    }
}

fn assert_i64(result: Result<i64, ActorError<redis.RedisError>>, expected: i64) {
    match result {
        .Ok(value) => assert(value == expected),
        .Err(_) => assert(false),
    }
}

fn assert_bool(result: Result<bool, ActorError<redis.RedisError>>, expected: bool) {
    match result {
        .Ok(value) => assert(value == expected),
        .Err(_) => assert(false),
    }
}

fn assert_value(result: Result<redis.Lookup, ActorError<redis.RedisError>>, expected: bytes) {
    match result {
        .Ok(.Value(value)) => assert_bytes(value, expected),
        _ => assert(false),
    }
}

fn assert_missing(result: Result<redis.Lookup, ActorError<redis.RedisError>>) {
    match result {
        .Ok(.Missing) => assert(true),
        _ => assert(false),
    }
}

fn assert_error<T>(result: Result<T, ActorError<redis.RedisError>>) {
    match result {
        .Err(.Failed(error)) => assert(!redis.error_message(error).is_empty()),
        _ => assert(false),
    }
}

fn assert_bytes_result(result: Result<bytes, ActorError<redis.RedisError>>, expected: bytes) {
    match result {
        .Ok(value) => assert_bytes(value, expected),
        .Err(_) => assert(false),
    }
}

fn client_actor() -> redis.Conn {
    spawn redis.Conn { options: redis.Options { url: "redis://127.0.0.1:6379/" } }
}

actor DelayedPublisher {
    let client: redis.Conn;

    receive fn publish(channel: string, message: bytes) {
        sleep(50ms);
        let _ = client.publish(channel, message);
    }
}

#[test]
#[real_time]
fn unavailable_endpoint_returns_connection_error() {
    let client = spawn redis.Conn { options: redis.Options { url: "redis://127.0.0.1:1/" } };
    match client.get("key") {
        .Ok(_) => assert(false),
        .Err(.Failed(.Connection(message))) => assert(!message.is_empty()),
        .Err(_) => assert(false),
    }
}

#[test]
#[real_time]
fn string_commands_preserve_missing_empty_and_nul() {
    let client = client_actor();
    let prefix = "hew:redis:beta:string";
    let _ = client.del(f"{prefix}:value");
    assert_i64(client.set(f"{prefix}:value", nul_value()), 0);
    assert_value(client.get(f"{prefix}:value"), nul_value());
    assert_missing(client.get(f"{prefix}:missing"));
    assert_i64(client.set(f"{prefix}:empty", bytes.new()), 0);
    assert_value(client.get(f"{prefix}:empty"), bytes.new());
    assert_i64(client.del(f"{prefix}:empty"), 1);
    stop(client);
    stopped(client);
}

#[test]
#[real_time]
fn expiration_commands_return_typed_outcomes() {
    let client = client_actor();
    let key = "hew:redis:beta:expiration";
    assert_i64(client.set_ex(key, binary("ttl"), 10), 0);
    assert_bool(client.expire(key, 20), true);
    match client.ttl(key) {
        .Ok(.Seconds(seconds)) => assert(seconds > 0),
        _ => assert(false),
    }
    match client.ttl("hew:redis:beta:missing-ttl") {
        .Ok(.Missing) => assert(true),
        _ => assert(false),
    }
    assert_error(client.set_ex(key, binary("bad"), 0));
    stop(client);
    stopped(client);
}

#[test]
#[real_time]
fn increment_returns_exact_new_value() {
    let client = client_actor();
    let key = "hew:redis:beta:counter";
    assert_i64(client.set(key, binary("40")), 0);
    assert_i64(client.incr(key), 41);
    stop(client);
    stopped(client);
}

#[test]
#[real_time]
fn list_commands_preserve_nul_and_empty_outcome() {
    let client = client_actor();
    let key = "hew:redis:beta:list";
    let _ = client.del(key);
    assert_i64(client.lpush(key, nul_value()), 1);
    assert_value(client.rpop(key), nul_value());
    assert_missing(client.rpop(key));
    stop(client);
    stopped(client);
}

#[test]
#[real_time]
fn hash_commands_preserve_nul_and_missing_outcome() {
    let client = client_actor();
    let key = "hew:redis:beta:hash";
    let _ = client.del(key);
    assert_bool(client.hset(key, "field", nul_value()), true);
    assert_value(client.hget(key, "field"), nul_value());
    assert_missing(client.hget(key, "missing"));
    match client.hgetall(key) {
        .Ok(entries) => {
            assert(entries.len() == 1);
            assert_bytes(entries[0].value, nul_value());
        }
        _ => assert(false),
    }
    assert_bool(client.hdel(key, "field"), true);
    stop(client);
    stopped(client);
}

#[test]
#[real_time]
fn unicode_key_and_field_round_trip_through_native() {
    let client = client_actor();
    let _ = client.del(unicode_key());
    assert_bool(client.hset(unicode_key(), unicode_field(), unicode_value()), true);
    assert_value(client.hget(unicode_key(), unicode_field()), unicode_value());
    match client.hgetall(unicode_key()) {
        .Ok(entries) => {
            assert(entries.len() == 1);
            assert(entries[0].field == unicode_field());
            assert_bytes(entries[0].value, unicode_value());
        }
        _ => assert(false),
    }
    let _ = client.del(unicode_key());
    stop(client);
    stopped(client);
}

#[test]
#[real_time]
fn set_commands_preserve_binary_members() {
    let client = client_actor();
    let key = "hew:redis:beta:set";
    let _ = client.del(key);
    assert_bool(client.sadd(key, nul_value()), true);
    assert_bool(client.sismember(key, nul_value()), true);
    match client.smembers(key) {
        .Ok(members) => {
            assert(members.len() == 1);
            assert_bytes(members[0].value, nul_value());
        }
        _ => assert(false),
    }
    assert_bool(client.srem(key, nul_value()), true);
    stop(client);
    stopped(client);
}

#[test]
#[real_time]
fn pipeline_executes_or_reports_command_error() {
    let client = client_actor();
    var commands: Vec<redis.PipelineCommand> = Vec.new();
    commands.push(redis.PipelineCommand.Set("hew:redis:beta:pipeline", binary("done")));
    commands.push(redis.PipelineCommand.Hset("hew:redis:beta:pipeline-hash", "field", nul_value()));
    commands.push(redis.PipelineCommand.Del("hew:redis:beta:pipeline-delete"));
    assert_i64(client.pipeline_exec(commands), 0);
    assert_value(client.get("hew:redis:beta:pipeline"), binary("done"));
    var ping: Vec<redis.PipelineCommand> = Vec.new();
    ping.push(redis.PipelineCommand.Ping);
    assert_i64(client.pipeline_exec(ping), 0);
    var invalid: Vec<redis.PipelineCommand> = Vec.new();
    invalid.push(redis.PipelineCommand.Hset("hew:redis:beta:pipeline", "field", binary("wrong-type")));
    assert_error(client.pipeline_exec(invalid));
    stop(client);
    stopped(client);
}

#[test]
#[real_time]
fn pubsub_preserves_binary_messages_and_times_out_typed() {
    let subscriber = client_actor();
    let publisher = client_actor();
    let delayed = spawn DelayedPublisher { client: publisher };
    let _ = mailbox(delayed, on_full: .Reject).publish("hew:redis:beta:channel", nul_value());
    assert_bytes_result(subscriber.subscribe_once("hew:redis:beta:channel", 1000), nul_value());
    assert_error(subscriber.subscribe_once("hew:redis:beta:timeout", 1));
    assert_i64(publisher.publish("hew:redis:beta:no-subscribers", binary("message")), 0);
    stop(subscriber);
    stopped(subscriber);
    stop(publisher);
    stopped(publisher);
}

#[test]
#[real_time]
fn calls_to_a_stopped_client_report_dead() {
    let client = client_actor();
    stop(client);
    stopped(client);
    match client.get("hew:redis:beta:closed") {
        .Err(.Dead) => {}
        _ => assert(false),
    }
}

fn create_actor_without_explicit_close(previous_count: i64) -> redis.Conn {
    let client = client_actor();
    assert_i64(client.set("hew:redis:beta:abandoned", binary("released")), 0);
    assert(unsafe {
        hew_redis_connection_count()
    } == previous_count + 1);
    client
}

#[test]
#[real_time]
fn abandoned_actor_releases_connection_on_stop() {
    let previous_count = unsafe {
        hew_redis_connection_count()
    };
    assert(previous_count >= 0);
    let client = create_actor_without_explicit_close(previous_count);
    stop(client);
    stopped(client);
    var attempts = 0;
    while unsafe {
        hew_redis_connection_count()
    } != previous_count && attempts < 100 {
        sleep(5ms);
        attempts = attempts + 1;
    }
    assert(unsafe {
        hew_redis_connection_count()
    } == previous_count);
}
