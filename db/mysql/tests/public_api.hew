import hew.db.mysql;

#[test]
#[real_time]
fn invalid_url_and_explicit_close_return_typed_errors() {
    let db = spawn mysql.Conn { url: "not-a-mysql-url" };
    match db.query("SELECT 1") {
        .Err(.Failed(.Connect(message))) => assert(!message.is_empty()),
        _ => assert(false),
    }
    stop(db);
    stopped(db);
    match db.query("SELECT 1") {
        .Err(.Dead) => {}
        _ => assert(false),
    }
}
