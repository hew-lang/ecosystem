//! Actor-owned MySQL client with typed query results.
//!
//! Every fallible operation returns `Result`. Query rows are immutable,
//! `#[wire]` snapshots, and SQL `NULL` is represented by `CellValue.Null`.

#[wire]
pub enum MysqlError {
    Connect(string);
    InvalidInput(string);
    Query(string);
    Closed(string);
    Internal(string);
}

/// Return the diagnostic carried by a `MysqlError`.
pub fn error_message(error: MysqlError) -> string {
    match error {
        .Connect(message) => message,
        .InvalidInput(message) => message,
        .Query(message) => message,
        .Closed(message) => message,
        .Internal(message) => message,
    }
}

#[wire]
pub enum CellValue {
    Null;
    Text(bytes);
}

#[wire]
pub type Row {
    values: Vec<CellValue> @1,
}

#[wire]
pub type QueryResult {
    columns: Vec<string> @1,
    rows: Vec<Row> @2,
}

/// Map a native `hew_mysql_last_error_kind()` code to a typed `MysqlError`.
fn error_from_kind(kind: i32, message: string) -> MysqlError {
    match kind {
        1 => MysqlError.Connect(message),
        2 => MysqlError.InvalidInput(message),
        3 => MysqlError.Query(message),
        4 => MysqlError.Closed(message),
        _ => MysqlError.Internal(message),
    }
}

fn native_error() -> MysqlError {
    let message = unsafe {
        hew_mysql_last_error()
    };
    let kind = unsafe {
        hew_mysql_last_error_kind()
    };
    error_from_kind(kind, message)
}

fn connection_handle(closed: bool, handle: i64, error_kind: i32, error_message: string) -> Result<i64, MysqlError> {
    if closed {
        Err(MysqlError.Closed("MySQL connection is closed"))
    } else if handle == 0 {
        Err(error_from_kind(error_kind, error_message))
    } else {
        Ok(handle)
    }
}

#[resource]
type NativeResult {
    handle: i64;
}

impl NativeResult {
    fn row_count(self) -> i64 {
        unsafe {
            hew_mysql_result_rows(self.handle)
        }
    }

    fn column_count(self) -> i64 {
        unsafe {
            hew_mysql_result_cols(self.handle)
        }
    }

    fn column(self, index: i64) -> bytes {
        unsafe {
            hew_mysql_result_column(self.handle, index)
        }
    }

    fn cell_kind(self, row: i64, column: i64) -> i32 {
        unsafe {
            hew_mysql_result_cell_kind(self.handle, row, column)
        }
    }

    fn cell(self, row: i64, column: i64) -> bytes {
        unsafe {
            hew_mysql_result_cell(self.handle, row, column)
        }
    }

    fn close(consuming self) {
        unsafe {
            hew_mysql_result_free(self.handle)
        };
    }
}

fn collect_result(result: NativeResult) -> Result<QueryResult, MysqlError> {
    let row_count = result.row_count();
    let column_count = result.column_count();
    if row_count < 0 || column_count < 0 {
        let error = native_error();
        result.close();
        return Err(error);
    }
    let columns: Vec<string> = Vec.new();
    for column in 0 .. column_count {
        let value = result.column(column);
        columns.push(value.to_string());
    }
    let rows: Vec<Row> = Vec.new();
    for row in 0 .. row_count {
        let values: Vec<CellValue> = Vec.new();
        for column in 0 .. column_count {
            match result.cell_kind(row, column) {
                0 => values.push(CellValue.Null),
                1 => {
                    let value = result.cell(row, column);
                    values.push(CellValue.Text(value));
                },
                _ => {
                    let error = native_error();
                    result.close();
                    return Err(error);
                },
            }
        }
        rows.push(Row { values: values });
    }
    result.close();
    Ok(QueryResult { columns: columns, rows: rows })
}

/// An actor that owns and serializes one MySQL connection.
pub actor Conn {
    var handle: i64 = 0;
    var connect_error_kind: i32 = 0;
    var connect_error_message: string = "";
    var closed: bool = false;

    init(url: string) {
        handle = unsafe {
            hew_mysql_connect_len(url, url.len())
        };
        if handle == 0 {
            connect_error_kind = unsafe {
                hew_mysql_last_error_kind()
            };
            connect_error_message = unsafe {
                hew_mysql_last_error()
            };
        }
    }

    /// Execute SQL and return the exact affected-row count.
    receive fn execute(sql: string) -> Result<i64, MysqlError> {
        let connection = connection_handle(closed, handle, connect_error_kind, connect_error_message.clone())?;
        let affected = unsafe {
            hew_mysql_execute_len(connection, sql, sql.len())
        };
        if unsafe {
            hew_mysql_last_error_kind()
        } == 0 {
            Ok(affected)
        } else {
            Err(native_error())
        }
    }

    /// Execute SQL with newline-delimited text parameters.
    receive fn execute_params(sql: string, params: bytes) -> Result<i64, MysqlError> {
        let connection = connection_handle(closed, handle, connect_error_kind, connect_error_message.clone())?;
        let affected = unsafe {
            hew_mysql_execute_params_len(connection, sql, sql.len(), params)
        };
        if unsafe {
            hew_mysql_last_error_kind()
        } == 0 {
            Ok(affected)
        } else {
            Err(native_error())
        }
    }

    /// Query SQL and return a wire-safe snapshot.
    receive fn query(sql: string) -> Result<QueryResult, MysqlError> {
        let connection = connection_handle(closed, handle, connect_error_kind, connect_error_message.clone())?;
        let result = NativeResult { handle: unsafe {
            hew_mysql_query_len(connection, sql, sql.len())
        } };
        if result.handle == 0 {
            return Err(native_error());
        }
        collect_result(result)
    }

    /// Query SQL with newline-delimited text parameters.
    receive fn query_params(sql: string, params: bytes) -> Result<QueryResult, MysqlError> {
        let connection = connection_handle(closed, handle, connect_error_kind, connect_error_message.clone())?;
        let result = NativeResult { handle: unsafe {
            hew_mysql_query_params_len(connection, sql, sql.len(), params)
        } };
        if result.handle == 0 {
            return Err(native_error());
        }
        collect_result(result)
    }

    /// Close the native connection. Repeated calls are harmless.
    receive fn close() {
        if handle != 0 {
            unsafe {
                hew_mysql_close(handle)
            };
            handle = 0;
        }
        closed = true;
    }

    #[on(stop)]
    fn release_native_handle() {
        if handle != 0 {
            unsafe {
                hew_mysql_close(handle)
            };
            handle = 0;
        }
    }
}

extern "C" {
    fn hew_mysql_connect_len(url: string, url_len: i64) -> i64;
    fn hew_mysql_execute_len(connection: i64, sql: string, sql_len: i64) -> i64;
    fn hew_mysql_execute_params_len(connection: i64, sql: string, sql_len: i64, params: bytes) -> i64;
    fn hew_mysql_query_len(connection: i64, sql: string, sql_len: i64) -> i64;
    fn hew_mysql_query_params_len(connection: i64, sql: string, sql_len: i64, params: bytes) -> i64;
    fn hew_mysql_result_rows(result: i64) -> i64;
    fn hew_mysql_result_cols(result: i64) -> i64;
    fn hew_mysql_result_column(result: i64, index: i64) -> bytes;
    fn hew_mysql_result_cell_kind(result: i64, row: i64, column: i64) -> i32;
    fn hew_mysql_result_cell(result: i64, row: i64, column: i64) -> bytes;
    fn hew_mysql_result_free(result: i64);
    fn hew_mysql_close(connection: i64);
    fn hew_mysql_last_error_kind() -> i32;
    fn hew_mysql_last_error() -> string;
}
