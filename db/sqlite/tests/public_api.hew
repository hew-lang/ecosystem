import hew.db.sqlite;

import hew.db.sqlite.{CellValue, Row, QueryResult};

fn error_variants_preserve_diagnostics() {
    assert(sqlite.error_message(sqlite.SqliteError.Open("open")) == "open");
    assert(sqlite.error_message(sqlite.SqliteError.InvalidInput("input")) == "input");
    assert(sqlite.error_message(sqlite.SqliteError.Query("query")) == "query");
    assert(sqlite.error_message(sqlite.SqliteError.Closed("closed")) == "closed");
    assert(sqlite.error_message(sqlite.SqliteError.Internal("internal")) == "internal");
}

fn wire_values_distinguish_null_empty_and_no_rows() {
    var values: Vec<CellValue> = Vec.new();
    values.push(CellValue.Null);
    values.push(CellValue.Text(bytes.new()));
    var rows: Vec<Row> = Vec.new();
    rows.push(Row { values: values });
    let result = QueryResult { columns: Vec.new(), rows: rows };
    assert(result.rows.len() == 1);
    match result.rows[0].values[0] {
        .Null => assert(true),
        _ => assert(false),
    }
    match result.rows[0].values[1] {
        .Text(value) => assert(value.len() == 0),
        _ => assert(false),
    }
}

fn main() {
    error_variants_preserve_diagnostics();
    wire_values_distinguish_null_empty_and_no_rows();
}
