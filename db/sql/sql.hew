//! Typed parameters and query results shared by the SQL database clients.
//!
//! Text is UTF-8 and may contain newlines. Bytes preserves arbitrary binary
//! data. Null binds SQL NULL; it is distinct from an empty Text or Bytes value.
//! SQL placeholders and database conversion rules remain driver-specific.

#[wire]
pub enum Param {
    Null @0;
    Bool(bool) @1;
    Int(i64) @2;
    Float(f64) @3;
    Text(string) @4;
    Bytes(bytes) @5;
}

/// One result cell: SQL `NULL`, or the column value as the driver's text
/// representation. The bytes need not be UTF-8.
#[wire]
pub enum CellValue {
    Null @0;
    Text(bytes) @1;
}

/// One result row, with a value for each column in order.
#[wire]
pub type Row {
    values: Vec<CellValue> @1;
}

/// An immutable snapshot of a query's column names and rows.
#[wire]
pub type QueryResult {
    columns: Vec<string> @1;
    rows: Vec<Row> @2;
}
