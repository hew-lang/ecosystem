}

#[test]
#[real_time]
fn count_invalid_filter_returns_invalid_json() {
    let db = connect();
    match db.count("beta_invalid", "not json") {
        .Ok(result) => match result {
            .Err(.InvalidJson(_)) => {}
            _ => panic("expected InvalidJson from count"),
        }
        .Err(_) => panic("actor stopped during invalid count"),
