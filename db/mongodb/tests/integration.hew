//! Service-backed public API coverage.
//!
//! Run with MongoDB listening on 127.0.0.1:27017. Each scenario uses a
//! dedicated key and removes every document it inserts.

import hew.db.mongodb;

fn cleanup_fixture(db: LocalPid<mongodb.Conn>, collection: string, filter: string) {
    match await db.delete_one(collection, filter) {
        .Ok(result) => match result {
            .Ok(_) => {},
            .Err(error) => panic(mongodb.error_message(error)),
        },
        .Err(_) => panic("actor stopped during fixture cleanup"),
    }
}

fn insert_fixture(db: LocalPid<mongodb.Conn>, collection: string, document: string) {
    match await db.insert_one(collection, document) {
        .Ok(result) => match result {
            .Ok(id) => assert(!id.is_empty()),
            .Err(error) => panic(mongodb.error_message(error)),
        },
        .Err(_) => panic("actor stopped during fixture insert"),
    }
}

fn insert_one_valid_document_returns_nonempty_id(db: LocalPid<mongodb.Conn>) {
    let collection = "beta_insert";
    let filter = "{\"test_key\":\"insert\"}";
    cleanup_fixture(db, collection, filter.clone());
    match await db.insert_one(collection, "{\"test_key\":\"insert\",\"value\":1}") {
        .Ok(result) => match result {
            .Ok(id) => assert(!id.is_empty()),
            .Err(error) => panic(mongodb.error_message(error)),
        },
        .Err(_) => panic("actor stopped during insert_one"),
    }
    cleanup_fixture(db, collection, filter);
}

fn find_one_existing_document_returns_found_value(db: LocalPid<mongodb.Conn>) {
    let collection = "beta_find_one";
    let filter = "{\"test_key\":\"find-one\"}";
    cleanup_fixture(db, collection, filter.clone());
    insert_fixture(db, collection, "{\"test_key\":\"find-one\",\"value\":17}");
    match await db.find_one(collection, filter.clone()) {
        .Ok(result) => match result {
            .Ok(.Found(document)) => {
                assert(document.contains("\"test_key\":\"find-one\""));
                assert(document.contains("\"value\":17"));
            },
            .Ok(.Missing) => panic("fixture document was missing"),
            .Err(error) => panic(mongodb.error_message(error)),
        },
        .Err(_) => panic("actor stopped during find_one"),
    }
    cleanup_fixture(db, collection, filter);
}

fn find_one_absent_document_returns_missing_value(db: LocalPid<mongodb.Conn>) {
    let collection = "beta_missing";
    let filter = "{\"test_key\":\"absent\"}";
    cleanup_fixture(db, collection, filter.clone());
    match await db.find_one(collection, filter) {
        .Ok(result) => match result {
            .Ok(.Missing) => {},
            _ => panic("absent document should return Missing"),
        },
        .Err(_) => panic("actor stopped during missing find_one"),
    }
}

fn find_matching_documents_returns_exact_query_contents(db: LocalPid<mongodb.Conn>) {
    let collection = "beta_find";
    let filter = "{\"test_key\":\"find\"}";
    cleanup_fixture(db, collection, filter.clone());
    insert_fixture(db, collection, "{\"test_key\":\"find\",\"value\":23}");
    match await db.find(collection, filter.clone()) {
        .Ok(result) => match result {
            .Ok(query) => {
                assert_eq(query.documents.len(), 1);
                assert(query.documents[0].contains("\"value\":23"));
            },
            .Err(error) => panic(mongodb.error_message(error)),
        },
        .Err(_) => panic("actor stopped during find"),
    }
    cleanup_fixture(db, collection, filter);
}

fn repeated_find_returns_fresh_results_after_cursor_cleanup(db: LocalPid<mongodb.Conn>) {
    let collection = "beta_cursor_cleanup";
    let filter = "{\"test_key\":\"cursor-cleanup\"}";
    cleanup_fixture(db, collection, filter.clone());
    insert_fixture(db, collection, "{\"test_key\":\"cursor-cleanup\",\"value\":31}");
    match await db.find(collection, filter.clone()) {
        .Ok(result) => match result {
            .Ok(query) => assert_eq(query.documents.len(), 1),
            .Err(error) => panic(mongodb.error_message(error)),
        },
        .Err(_) => panic("actor stopped during first find"),
    }
    match await db.find(collection, filter.clone()) {
        .Ok(result) => match result {
            .Ok(query) => {
                assert_eq(query.documents.len(), 1);
                assert(query.documents[0].contains("\"value\":31"));
            },
            .Err(error) => panic(mongodb.error_message(error)),
        },
        .Err(_) => panic("actor stopped during repeated find"),
    }
    cleanup_fixture(db, collection, filter);
}

fn update_one_matching_document_returns_modified_count(db: LocalPid<mongodb.Conn>) {
    let collection = "beta_update";
    let filter = "{\"test_key\":\"update\"}";
    cleanup_fixture(db, collection, filter.clone());
    insert_fixture(db, collection, "{\"test_key\":\"update\",\"status\":\"new\"}");
    match await db.update_one(collection, filter.clone(), "{\"$set\":{\"status\":\"updated\"}}") {
        .Ok(result) => match result {
            .Ok(modified) => assert_eq(modified, 1),
            .Err(error) => panic(mongodb.error_message(error)),
        },
        .Err(_) => panic("actor stopped during update_one"),
    }
    match await db.find_one(collection, filter.clone()) {
        .Ok(result) => match result {
            .Ok(.Found(document)) => assert(document.contains("\"status\":\"updated\"")),
            _ => panic("updated document was not found"),
        },
        .Err(_) => panic("actor stopped while verifying update"),
    }
    cleanup_fixture(db, collection, filter);
}

fn delete_one_matching_document_returns_deleted_count(db: LocalPid<mongodb.Conn>) {
    let collection = "beta_delete";
    let filter = "{\"test_key\":\"delete\"}";
    cleanup_fixture(db, collection, filter.clone());
    insert_fixture(db, collection, "{\"test_key\":\"delete\"}");
    match await db.delete_one(collection, filter.clone()) {
        .Ok(result) => match result {
            .Ok(deleted) => assert_eq(deleted, 1),
            .Err(error) => panic(mongodb.error_message(error)),
        },
        .Err(_) => panic("actor stopped during delete_one"),
    }
    match await db.find_one(collection, filter) {
        .Ok(result) => match result {
            .Ok(.Missing) => {},
            _ => panic("deleted document should be missing"),
        },
        .Err(_) => panic("actor stopped while verifying delete"),
    }
}

fn count_matching_documents_returns_exact_count(db: LocalPid<mongodb.Conn>) {
    let collection = "beta_count";
    let filter = "{\"test_key\":\"count\"}";
    cleanup_fixture(db, collection, filter.clone());
    insert_fixture(db, collection, "{\"test_key\":\"count\",\"value\":41}");
    match await db.count(collection, filter.clone()) {
        .Ok(result) => match result {
            .Ok(count) => assert_eq(count, 1),
            .Err(error) => panic(mongodb.error_message(error)),
        },
        .Err(_) => panic("actor stopped during count"),
    }
    cleanup_fixture(db, collection, filter.clone());
    match await db.count(collection, filter) {
        .Ok(result) => match result {
            .Ok(count) => assert_eq(count, 0),
            .Err(error) => panic(mongodb.error_message(error)),
        },
        .Err(_) => panic("actor stopped during empty count"),
    }
}

fn insert_one_invalid_document_returns_invalid_json(db: LocalPid<mongodb.Conn>) {
    match await db.insert_one("beta_invalid", "not json") {
        .Ok(result) => match result {
            .Err(.InvalidJson(message)) => assert(message.contains("invalid document JSON")),
            _ => panic("expected InvalidJson from insert_one"),
        },
        .Err(_) => panic("actor stopped during invalid insert"),
    }
}

fn find_one_non_object_filter_returns_invalid_json(db: LocalPid<mongodb.Conn>) {
    match await db.find_one("beta_invalid", "[]") {
        .Ok(result) => match result {
            .Err(.InvalidJson(message)) => assert(message.contains("filter must be a JSON object")),
            _ => panic("expected InvalidJson from find_one"),
        },
        .Err(_) => panic("actor stopped during invalid find_one"),
    }
}

fn find_invalid_filter_returns_invalid_json(db: LocalPid<mongodb.Conn>) {
    match await db.find("beta_invalid", "not json") {
        .Ok(result) => match result {
            .Err(.InvalidJson(_)) => {},
            _ => panic("expected InvalidJson from find"),
        },
        .Err(_) => panic("actor stopped during invalid find"),
    }
}

fn update_one_non_object_update_returns_invalid_json(db: LocalPid<mongodb.Conn>) {
    match await db.update_one("beta_invalid", "{}", "[]") {
        .Ok(result) => match result {
            .Err(.InvalidJson(message)) => assert(message.contains("update must be a JSON object")),
            _ => panic("expected InvalidJson from update_one"),
        },
        .Err(_) => panic("actor stopped during invalid update"),
    }
}

fn delete_one_invalid_filter_returns_invalid_json(db: LocalPid<mongodb.Conn>) {
    match await db.delete_one("beta_invalid", "not json") {
        .Ok(result) => match result {
            .Err(.InvalidJson(_)) => {},
            _ => panic("expected InvalidJson from delete_one"),
        },
        .Err(_) => panic("actor stopped during invalid delete"),
    }
}

fn count_invalid_filter_returns_invalid_json(db: LocalPid<mongodb.Conn>) {
    match await db.count("beta_invalid", "not json") {
        .Ok(result) => match result {
            .Err(.InvalidJson(_)) => {},
            _ => panic("expected InvalidJson from count"),
        },
        .Err(_) => panic("actor stopped during invalid count"),
    }
}

fn main() {
    let db = spawn mongodb.Conn(uri: "mongodb://127.0.0.1:27017/?serverSelectionTimeoutMS=1000", database: "hew_mongodb_public_integration");
    insert_one_valid_document_returns_nonempty_id(db);
    find_one_existing_document_returns_found_value(db);
    find_one_absent_document_returns_missing_value(db);
    find_matching_documents_returns_exact_query_contents(db);
    repeated_find_returns_fresh_results_after_cursor_cleanup(db);
    update_one_matching_document_returns_modified_count(db);
    delete_one_matching_document_returns_deleted_count(db);
    count_matching_documents_returns_exact_count(db);
    insert_one_invalid_document_returns_invalid_json(db);
    find_one_non_object_filter_returns_invalid_json(db);
    find_invalid_filter_returns_invalid_json(db);
    update_one_non_object_update_returns_invalid_json(db);
    delete_one_invalid_filter_returns_invalid_json(db);
    count_invalid_filter_returns_invalid_json(db);
    db.close();
}
