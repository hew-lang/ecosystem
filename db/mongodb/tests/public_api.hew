//! Offline end-to-end coverage for the public MongoDB actor API.

import hew.db.mongodb;

fn assert_connect_error(result: Result<i64, ActorError<mongodb.MongoError>>) {
    match result {
        .Err(.Failed(.Connect(message))) => assert(!message.is_empty()),
        _ => panic("expected MongoError.Connect"),
    }
}

#[test]
#[real_time]
fn connection_failure_is_typed_for_every_operation() {
    let db = spawn mongodb.Conn { uri: "mongodb://127.0.0.1:1/?serverSelectionTimeoutMS=10&connectTimeoutMS=10", database: "hew_offline_test" };
    match db.insert_one("items", "{\"value\":1}") {
        .Err(.Failed(.Connect(message))) => assert(!message.is_empty()),
        _ => panic("expected Connect from insert_one"),
    }
    match db.find_one("items", "{\"value\":1}") {
        .Err(.Failed(.Connect(message))) => assert(!message.is_empty()),
        _ => panic("expected Connect from find_one"),
    }
    match db.find("items", "{}") {
        .Err(.Failed(.Connect(message))) => assert(!message.is_empty()),
        _ => panic("expected Connect from find"),
    }
    assert_connect_error(db.update_one("items", "{\"value\":1}", "{\"$set\":{\"value\":2}}"));
    assert_connect_error(db.delete_one("items", "{\"value\":1}"));
    assert_connect_error(db.count("items", "{}"));
    stop(db);
    stopped(db);
    match db.count("items", "{}") {
        .Err(.Dead) => {}
        _ => panic("expected Dead after stop"),
    }
}
