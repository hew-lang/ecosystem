//! Publish one message and receive it back over an MQTT subscription.
//!
//! Start the broker from the ecosystem checkout with
//! `docker compose up -d mqtt`, then run:
//! `hew run --pkg-path . queue/mqtt/examples/pubsub.hew`
//!
//! With no broker listening the example prints the connection error and exits
//! successfully; it does not pretend the round trip happened.

import hew.queue.mqtt;

fn main() {
    let client = spawn mqtt.Conn(options: Options { host: "127.0.0.1", port: 11883, client_id: "hew-mqtt-example", keepalive_seconds: 30 });
    match await client.subscribe("hew/example", mqtt.QoS.AtLeastOnce) {
        .Ok(result) => match result {
            .Ok(_) => {
                match await client.publish("hew/example", "hello from Hew", mqtt.QoS.AtLeastOnce, false) {
                    .Ok(publish_result) => match publish_result {
                        .Ok(_) => {},
                        .Err(error) => println(mqtt.error_message(error)),
                    },
                    .Err(_) => println("MQTT actor stopped before replying"),
                }
                match await client.next_message(3000) {
                    .Ok(receive_result) => match receive_result {
                        .Ok(.Message(message)) => println(f"{message.topic}: {message.payload}"),
                        .Ok(.Missing) => println("no message arrived within 3 seconds"),
                        .Err(error) => println(mqtt.error_message(error)),
                    },
                    .Err(_) => println("MQTT actor stopped before replying"),
                }
            },
            .Err(error) => println(mqtt.error_message(error)),
        },
        .Err(_) => println("MQTT actor stopped before replying"),
    }
    let _ = client.close();
}
