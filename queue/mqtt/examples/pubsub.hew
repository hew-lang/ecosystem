//! Publish one message and receive it back over an MQTT subscription.
//!
//! The broker port comes from `HEW_MQTT_PORT`, and is the standard 1883 when
//! that is unset. Start the compose broker from the ecosystem checkout with
//! `docker compose up -d mqtt`, then run:
//! `HEW_MQTT_PORT=21883 hew run --pkg-path . queue/mqtt/examples/pubsub.hew`
//!
//! With no broker listening the example prints the connection error and exits
//! successfully; it does not pretend the round trip happened.

import std.os;

import std.string;

import hew.queue.mqtt;

fn broker_port() -> i64 {
    match os.env("HEW_MQTT_PORT") {
        .Some(text) => string.to_int(text) handle _ { 1883 },
        .None => 1883,
    }
}

fn main() {
    let client = spawn mqtt.Conn { options: mqtt.Options { host: "127.0.0.1", port: broker_port(), client_id: "hew-mqtt-example", keepalive_seconds: 30 } };
    match client.subscribe("hew/example", mqtt.QoS.AtLeastOnce) {
        .Ok(()) => {
            match client.publish("hew/example", "hello from Hew", mqtt.QoS.AtLeastOnce, false) {
                .Ok(()) => {}
                .Err(.Failed(error)) => println(mqtt.error_message(error)),
                .Err(_) => println("MQTT actor stopped before replying"),
            }
            match client.next_message(3000) {
                .Ok(.Message(message)) => println(f"{message.topic}: {message.payload}"),
                .Ok(.Missing) => println("no message arrived within 3 seconds"),
                .Err(.Failed(error)) => println(mqtt.error_message(error)),
                .Err(_) => println("MQTT actor stopped before replying"),
            }
        }
        .Err(.Failed(error)) => println(mqtt.error_message(error)),
        .Err(_) => println("MQTT actor stopped before replying"),
    }
    stop(client);
    stopped(client);
}

#[test]
#[real_time]
fn runs_to_completion() {
    main();
}
