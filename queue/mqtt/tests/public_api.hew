import hew.queue.mqtt;

import hew.queue.mqtt.{MqttError, QoS};

fn qos_levels_are_exact_and_invalid_values_fail_closed() {
    match mqtt.qos_from_level(0) {
        .Ok(.AtMostOnce) => {}
        _ => assert(false),
    }
    match mqtt.qos_from_level(1) {
        .Ok(.AtLeastOnce) => {}
        _ => assert(false),
    }
    match mqtt.qos_from_level(2) {
        .Ok(.ExactlyOnce) => {}
        _ => assert(false),
    }
    match mqtt.qos_from_level(3) {
        .Err(.InvalidInput(message)) => assert(message == "MQTT QoS must be 0, 1, or 2"),
        _ => assert(false),
    }
}

fn unavailable_broker_returns_typed_connection_error() {
    let client = spawn mqtt.Conn(options: mqtt.Options { host: "127.0.0.1", port: 1, client_id: "hew-mqtt-unavailable", keepalive_seconds: 30 });
    match client.publish("hew/test", "value", mqtt.QoS.AtMostOnce, false) {
        .Ok(.Err(.Connection(message))) => assert(!message.is_empty()),
        _ => assert(false),
    }
    stop(client);
    stopped(client);
}

fn main() {
    qos_levels_are_exact_and_invalid_values_fail_closed();
    unavailable_broker_returns_typed_connection_error();
}
