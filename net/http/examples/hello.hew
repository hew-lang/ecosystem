//! Serve one plain-text HTTP response, then stop.
//!
//! `accept_one()` reports an `Accept` error after an idle 250 milliseconds, so
//! this example retries it for about thirty seconds. That is long enough to
//! start the program in one terminal and send the request from another.
//!
//! Run from the ecosystem checkout with:
//! `hew run --pkg-path . net/http/examples/hello.hew`
//!
//! Then, in a second terminal:
//! `curl http://127.0.0.1:8080/hello`
//! Set `HEW_HTTP_EXAMPLE_ADDR` to use another local address or port.

import hew.net.http;

import std.net.http.http_client;

import std.os;

fn example_addr() -> string {
    os.env("HEW_HTTP_EXAMPLE_ADDR") ?? "127.0.0.1:8080"
}

// Answers the first request on `addr` and returns its method and path, or
// what stopped the server before it could answer one.
fn serve_one(addr: string) -> string {
    let server = spawn http.Server { addr: addr };
    var outcome = "no request arrived within 30 seconds";
    var attempts_left = 120;
    var served = false;
    while attempts_left > 0 && !served {
        attempts_left = attempts_left - 1;
        match server.accept_one() {
            .Ok(result) => match result {
                .Ok(request) => {
                    outcome = f"{request.method()} {request.path()}";
                    match server.respond_text(200, "Hello from Hew!\n") {
                        .Ok(response_result) => match response_result {
                            .Ok(_) => {}
                            .Err(error) => {
                                outcome = http.error_message(error);
                            }
                        }
                        .Err(_) => {
                            outcome = "HTTP server actor stopped before replying";
                        }
                    }
                    served = true;
                }
                // An idle quarter second is the documented outcome of
                // accept_one(), so it is a retry rather than a failure.
                .Err(.Accept(_)) => {}
                .Err(error) => {
                    outcome = http.error_message(error);
                    served = true;
                }
            }
            .Err(_) => {
                outcome = "HTTP server actor stopped before replying";
                served = true;
            }
        }
    }
    stop(server);
    stopped(server);
    outcome
}

fn main() {
    let addr = example_addr();
    println(f"listening for one request on http://{addr}");
    println(f"send it within 30 seconds, for example: curl http://{addr}/hello");
    println(serve_one(addr));
}

#[test]
#[real_time]
fn answers_one_request_over_http() {
    let addr = example_addr();
    scope {
        let served = fork serve_one(addr.clone());
        var body: Option<string> = .None;
        var attempts_left = 40;
        while body.is_none() && attempts_left > 0 {
            attempts_left = attempts_left - 1;
            body = http_client.get_string(f"http://{addr}/hello");
            if body.is_none() {
                sleep(250ms);
            }
        }
        assert(body == .Some("Hello from Hew!\n"));
        assert((await served) == "GET /hello");
    }
}
