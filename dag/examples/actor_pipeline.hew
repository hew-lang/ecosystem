// actor_pipeline.hew — route an input through LIVE per-node actors.
//
// The DAG library supplies the runtime spec loading, validation, topological
// order and routing; this example supplies the *actors*. Each node is a live
// `Stage` actor, and the `route_with` dispatch asks the node's actor for its
// output. `route_with` takes a `fn[suspends]` dispatch, so the dispatch can
// wait on an actor directly.
//
//   node0 (add 1) ──> node1 (multiply 10) ──> node2 (add 100)
//
// Input 5:  node0: 5+1=6 ;  node1: 6*10=60 ;  node2: 60+100=160
//
// Run from the ecosystem root:  hew run dag/examples/actor_pipeline.hew
import hew.dag;

// A live graph node. The operation is decoded once, before the actor is
// spawned, so `process` cannot meet an unknown operation code.
actor Stage {
    let op: dag.NodeOp;
    let operand: i64;

    receive fn process(x: i64) -> i64 {
        dag.apply_op(op, x, operand)
    }
}

// Spawn one `Stage` per node, or report the first node whose operation code
// this version does not know.
fn spawn_stages(spec: dag.DagSpec) -> Vec<Stage> fails dag.DagError {
    var stages: Vec<Stage> = Vec.new();
    for i in 0..dag.node_count(spec) {
        let node = dag.node_at(spec, i);
        let op = dag.op_of_code(node.op_code) handle error {
            stop_stages(stages);
            return error error;
        };
        stages.push(spawn Stage { op: op, operand: node.operand });
    }
    stages
}

fn stop_stages(stages: Vec<Stage>) {
    for stage in stages {
        stop(stage);
        stopped(stage);
    }
}

fn main() {
    let spec_text = "add:1 multiply:10 add:100 | 0->1 ; 1->2";
    println(f"loading spec: {spec_text}");
    match dag.parse_spec(spec_text) {
        .Ok(spec) => {
            match spawn_stages(spec) {
                .Ok(stages) => {
                    // Each node's output is its own actor's reply. An ask that
                    // gets no reply stops the run at that node.
                    let report = dag.route_with(spec, 5, |node: i64, input: i64| -> i64 fails dag.DagError {
                        let output = stages[node].process(input).map_err(|_| dag.DagError.Dispatch(node))?;
                        println(f"node {node}: in={input} -> out={output}");
                        output
                    });
                    stop_stages(stages);
                    match report {
                        .Ok(r) => {
                            let sink = dag.sink_output(r);
                            println(f"sink output = {sink}");
                            assert(sink == 160);
                            println("actor_pipeline: routed through live actors in topo order");
                        }
                        .Err(f) => println(dag.describe(dag.error_of(f))),
                    }
                }
                .Err(e) => println(dag.describe(e)),
            }
        }
        .Err(e) => println(dag.describe(e)),
    }
}

#[test]
fn runs_to_completion() {
    main();
}
