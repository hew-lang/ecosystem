//! `route_with` dispatches that ask live actors.

import hew.dag;

// A node actor that records every input it is asked to process.
actor Recorder {
    let op: dag.NodeOp;
    let operand: i64;
    var calls: i64 = 0;
    var last_input: i64 = 0;

    receive fn process(x: i64) -> i64 {
        calls = calls + 1;
        last_input = x;
        dag.apply_op(op, x, operand)
    }

    receive fn call_count() -> i64 {
        calls
    }

    receive fn input_seen() -> i64 {
        last_input
    }
}

fn spawn_recorders(spec: dag.DagSpec) -> Vec<Recorder> {
    var recorders: Vec<Recorder> = Vec.new();
    for i in 0..dag.node_count(spec) {
        let node = dag.node_at(spec, i);
        match dag.op_of_code(node.op_code) {
            .Ok(op) => recorders.push(spawn Recorder { op: op, operand: node.operand }),
            .Err(_) => assert(false),
        }
    }
    recorders
}

fn stop_recorders(recorders: Vec<Recorder>) {
    for recorder in recorders {
        stop(recorder);
        stopped(recorder);
    }
}

fn route_through(spec: dag.DagSpec, recorders: Vec<Recorder>, initial: i64) -> Result<dag.RunReport, dag.RunFailure> {
    dag.route_with(spec, initial, |node: i64, input: i64| -> i64 fails dag.DagError {
        recorders[node].process(input).map_err(|_| dag.DagError.Dispatch(node))?
    })
}

fn assert_asked_once_with(recorder: Recorder, input: i64) {
    match recorder.call_count() {
        .Ok(calls) => assert(calls == 1),
        .Err(_) => assert(false),
    }
    match recorder.input_seen() {
        .Ok(seen) => assert(seen == input),
        .Err(_) => assert(false),
    }
}

#[test]
fn dispatch_asks_each_node_actor_once_in_dependency_order() {
    // node0 id -> {node1 add 10, node2 add 20} -> node3 id (sums predecessors).
    match dag.parse_spec("id:0 add:10 add:20 id:0 | 0->1 ; 0->2 ; 1->3 ; 2->3") {
        .Ok(spec) => {
            let recorders = spawn_recorders(spec);
            match route_through(spec, recorders, 5) {
                .Ok(report) => {
                    assert(dag.output_at(report, 0) == 5);
                    assert(dag.output_at(report, 1) == 15);
                    assert(dag.output_at(report, 2) == 25);
                    assert(dag.sink_output(report) == 40);
                }
                .Err(_) => assert(false),
            }
            // The fan-in node saw both predecessors' replies, so the actors
            // answered before the dispatch moved on.
            assert_asked_once_with(recorders[0], 5);
            assert_asked_once_with(recorders[1], 5);
            assert_asked_once_with(recorders[2], 5);
            assert_asked_once_with(recorders[3], 40);
            stop_recorders(recorders);
        }
        .Err(_) => assert(false),
    }
}

#[test]
fn refused_spec_never_asks_an_actor() {
    match dag.parse_spec("add:1 add:1 | 0->1 ; 1->0") {
        .Ok(spec) => {
            let recorders = spawn_recorders(spec);
            match route_through(spec, recorders, 1) {
                .Ok(_) => assert(false),
                .Err(failure) => assert(dag.is_cyclic(dag.error_of(failure))),
            }
            for recorder in recorders {
                match recorder.call_count() {
                    .Ok(calls) => assert(calls == 0),
                    .Err(_) => assert(false),
                }
            }
            stop_recorders(recorders);
        }
        .Err(_) => assert(false),
    }
}

#[test]
fn unanswered_ask_stops_the_run_at_that_node() {
    // node0 -> node1 -> node2, with node1's actor stopped before routing.
    match dag.parse_spec("add:1 multiply:10 add:100 | 0->1 ; 1->2") {
        .Ok(spec) => {
            let recorders = spawn_recorders(spec);
            stop(recorders[1]);
            stopped(recorders[1]);
            match route_through(spec, recorders, 5) {
                .Ok(_) => assert(false),
                .Err(failure) => {
                    assert(failure.stopped_at == 1);
                    match dag.error_of(failure) {
                        .Dispatch(node) => assert(node == 1),
                        _ => assert(false),
                    }
                }
            }
            assert_asked_once_with(recorders[0], 5);
            match recorders[2].call_count() {
                .Ok(calls) => assert(calls == 0),
                .Err(_) => assert(false),
            }
            stop_recorders(recorders);
        }
        .Err(_) => assert(false),
    }
}
