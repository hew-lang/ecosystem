// Run via `hew run --pkg-path <repo root> tests/integration.hew` (see
// .github/workflows/ci.yml), not `hew test`: main()-dispatch keeps this
// package's test entry points uniform across tests/public_api.hew and
// tests/integration.hew. This file also needs a live S3-compatible
// endpoint (e.g. MinIO on 127.0.0.1:9000).

import std.encoding.utf8;

import hew.storage.s3;

extern "C" {
    fn hew_s3_bucket_count() -> i64;
}

fn store() -> s3.Bucket {
    spawn s3.Bucket(options: s3.Options { endpoint: "http://127.0.0.1:9000", region: "us-east-1", bucket: "hew-test", access_key: "minioadmin", secret_key: "minioadmin" })
}

fn binary_round_trip_and_missing_are_distinct() {
    let client = store();
    var body: bytes = bytes.new();
    body.push(65);
    body.push(0);
    body.push(66);
    match client.put("hew/integration.bin", body, "application/octet-stream") {
        .Ok(.Ok(_)) => {}
        _ => assert(false),
    }
    match client.get("hew/integration.bin") {
        .Ok(.Ok(.Found(value))) => {
            assert(value.len() == 3);
            assert(value[1] as i64 == 0);
        }
        _ => assert(false),
    }
    match client.exists("hew/integration.bin") {
        .Ok(.Ok(value)) => assert(value),
        _ => assert(false),
    }
    match client.list("hew/") {
        .Ok(.Ok(values)) => assert(!values.is_empty()),
        _ => assert(false),
    }
    match client.presign("hew/integration.bin", "GET", 60) {
        .Ok(.Ok(url)) => assert(url.contains("X-Amz-Signature")),
        _ => assert(false),
    }
    match client.delete("hew/integration.bin") {
        .Ok(.Ok(_)) => {}
        _ => assert(false),
    }
    match client.get("hew/integration.bin") {
        .Ok(.Ok(.Missing)) => {}
        _ => assert(false),
    }
    stop(client);
    stopped(client);
    sleep(20ms);
}

fn put_then_get_and_list_round_trip_unicode_key() {
    let client = store();
    let key = "hew/naïve-résumé-日本語-object.txt";
    let text = "hello from the naïve résumé, 日本語 payload";
    match client.put(key, text.to_bytes(), "text/plain; charset=utf-8") {
        .Ok(.Ok(_)) => {}
        _ => assert(false),
    }
    match client.get(key) {
        .Ok(.Ok(.Found(value))) => assert(utf8.decode_lossy(value) == text),
        _ => assert(false),
    }
    match client.list("hew/naïve") {
        .Ok(.Ok(values)) => {
            var found = false;
            for entry in values {
                if entry.key == key {
                    found = true;
                }
            }
            assert(found);
        }
        _ => assert(false),
    }
    match client.delete(key) {
        .Ok(.Ok(_)) => {}
        _ => assert(false),
    }
    stop(client);
    stopped(client);
    sleep(20ms);
}

fn get_missing_key_is_distinct_from_present() {
    let client = store();
    match client.get("hew/does-not-exist-at-all") {
        .Ok(.Ok(.Missing)) => {}
        _ => assert(false),
    }
    stop(client);
    stopped(client);
    sleep(20ms);
}

fn bad_access_key_fails_typed() {
    let client = spawn s3.Bucket(options: s3.Options { endpoint: "http://127.0.0.1:9000", region: "us-east-1", bucket: "hew-test", access_key: "not-the-real-key", secret_key: "not-the-real-secret" });
    match client.get("hew/integration.bin") {
        .Ok(.Err(error)) => assert(!s3.error_message(error).is_empty()),
        _ => assert(false),
    }
    stop(client);
    stopped(client);
    sleep(20ms);
}

fn actor_stop_releases_relative_bucket_count() {
    let before = unsafe {
        hew_s3_bucket_count()
    };
    let client = store();
    match client.presign("actor-stop", "GET", 60) {
        .Ok(.Ok(_)) => {}
        _ => assert(false),
    }
    assert(unsafe {
        hew_s3_bucket_count()
    } == before + 1);
    stop(client);
    stopped(client);
    var attempts = 0;
    while unsafe {
        hew_s3_bucket_count()
    } != before && attempts < 100 {
        sleep(5ms);
        attempts = attempts + 1;
    }
    assert(unsafe {
        hew_s3_bucket_count()
    } == before);
}

fn invalid_presign_fails_typed() {
    let client = store();
    match client.presign("key", "POST", 60) {
        .Ok(.Err(error)) => assert(!s3.error_message(error).is_empty()),
        _ => assert(false),
    }
    stop(client);
    stopped(client);
    sleep(20ms);
}

fn main() {
    binary_round_trip_and_missing_are_distinct();
    put_then_get_and_list_round_trip_unicode_key();
    get_missing_key_is_distinct_from_present();
    bad_access_key_fails_typed();
    invalid_presign_fails_typed();
    actor_stop_releases_relative_bucket_count();
}
