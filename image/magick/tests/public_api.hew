import std.fs;

import std.os;

import std.testing;

import hew.image.magick;

extern "C" {
    fn hew_magick_image_count() -> i64;
}

/// Scratch files live in the system temporary directory, never beside the
/// program that ran the test.
fn scratch_path(name: string) -> string {
    os.temp_dir() + "/" + name
}

fn assert_ok_i64(result: Result<i64, magick.MagickError>) {
    match result {
        .Ok(_) => {},
        .Err(_) => testing.assert_true(false),
    }
}

fn transformations_cover_public_surface() {
    let path = scratch_path("magick-public-api.png");
    let _ = fs.delete(path);
    let image = spawn magick.Image(source: Source.Blank(80, 40, "blue"));
    match image.width() {
        .Ok(.Ok(value)) => testing.assert_eq(value as i64, 80),
        _ => testing.assert_true(false),
    }
    match image.height() {
        .Ok(.Ok(value)) => testing.assert_eq(value as i64, 40),
        _ => testing.assert_true(false),
    }
    match image.resize(40, 20) {
        .Ok(result) => assert_ok_i64(result),
        _ => testing.assert_true(false),
    }
    match image.crop(20, 10, 0, 0) {
        .Ok(result) => assert_ok_i64(result),
        _ => testing.assert_true(false),
    }
    match image.rotate(90.0) {
        .Ok(result) => assert_ok_i64(result),
        _ => testing.assert_true(false),
    }
    match image.blur(0.0, 1.0) {
        .Ok(result) => assert_ok_i64(result),
        _ => testing.assert_true(false),
    }
    match image.sharpen(0.0, 0.5) {
        .Ok(result) => assert_ok_i64(result),
        _ => testing.assert_true(false),
    }
    match image.flip() {
        .Ok(result) => assert_ok_i64(result),
        _ => testing.assert_true(false),
    }
    match image.flop() {
        .Ok(result) => assert_ok_i64(result),
        _ => testing.assert_true(false),
    }
    match image.thumbnail(5, 5) {
        .Ok(result) => assert_ok_i64(result),
        _ => testing.assert_true(false),
    }
    match image.write(path) {
        .Ok(result) => assert_ok_i64(result),
        _ => testing.assert_true(false),
    }
    let _ = image.close();
    sleep(20ms);
    let reopened = spawn magick.Image(source: Source.File(path));
    match reopened.format() {
        .Ok(.Ok(value)) => testing.assert_true(value == "PNG"),
        _ => testing.assert_true(false),
    }
    let _ = reopened.close();
    sleep(20ms);
    let _ = fs.delete(path);
}

/// A path carrying non-ASCII text and more than sixteen bytes has to reach
/// ImageMagick exactly as written, and the format has to come back out.
fn long_unicode_path_round_trips_a_written_image() {
    let path = scratch_path("magick-héllo-wörld-très-longue-imagé.png");
    let _ = fs.delete(path);
    let image = spawn magick.Image(source: Source.Blank(48, 32, "#3366cc"));
    match image.write(path) {
        .Ok(result) => assert_ok_i64(result),
        _ => testing.assert_true(false),
    }
    let _ = image.close();
    sleep(20ms);
    testing.assert_true(fs.exists(path));
    let reopened = spawn magick.Image(source: Source.File(path));
    match reopened.width() {
        .Ok(.Ok(value)) => testing.assert_eq(value as i64, 48),
        _ => testing.assert_true(false),
    }
    match reopened.height() {
        .Ok(.Ok(value)) => testing.assert_eq(value as i64, 32),
        _ => testing.assert_true(false),
    }
    match reopened.format() {
        .Ok(.Ok(value)) => testing.assert_true(value == "PNG"),
        _ => testing.assert_true(false),
    }
    let _ = reopened.close();
    sleep(20ms);
    let _ = fs.delete(path);
}

/// ImageMagick names the file it could not open, so the diagnostic proves the
/// path travelled in and the message travelled back out intact.
fn missing_file_error_carries_the_path() {
    let path = scratch_path("magick-manquant-wörld-très-longue.png");
    let _ = fs.delete(path);
    testing.assert_true(!fs.exists(path));
    let missing = spawn magick.Image(source: Source.File(path));
    match missing.width() {
        .Ok(.Err(error)) => testing.assert_true(magick.error_message(error).contains(path)),
        _ => testing.assert_true(false),
    }
    let _ = missing.close();
    sleep(20ms);
}

fn invalid_inputs_return_typed_errors() {
    let image = spawn magick.Image(source: Source.Blank(10, 10, "white"));
    match image.resize(0, 1) {
        .Ok(.Err(error)) => testing.assert_true(!magick.error_message(error).is_empty()),
        _ => testing.assert_true(false),
    }
    let _ = image.close();
    sleep(20ms);
    let rejected = spawn magick.Image(source: Source.Blank(10, 10, "pas-une-couleur"));
    match rejected.width() {
        .Ok(.Err(.InvalidInput(message))) => {
            testing.assert_true(message.contains("invalid image colour"));
        },
        _ => testing.assert_true(false),
    }
    let _ = rejected.close();
    sleep(20ms);
}

fn blob_round_trip_preserves_a_real_image() {
    let source = spawn magick.Image(source: Source.Blank(37, 19, "#2f80ed"));
    let encoded = match source.write_blob("PNG") {
        .Ok(.Ok(value)) => value,
        _ => {
            testing.assert_true(false);
            bytes.new()
        },
    };
    testing.assert_true(encoded.len() > 8);
    let _ = source.close();
    sleep(20ms);
    let decoded = spawn magick.Image(source: Source.Blob(encoded));
    match decoded.width() {
        .Ok(.Ok(value)) => testing.assert_eq(value as i64, 37),
        _ => testing.assert_true(false),
    }
    match decoded.height() {
        .Ok(.Ok(value)) => testing.assert_eq(value as i64, 19),
        _ => testing.assert_true(false),
    }
    match decoded.format() {
        .Ok(.Ok(value)) => testing.assert_true(value == "PNG"),
        _ => testing.assert_true(false),
    }
    let _ = decoded.close();
    sleep(20ms);
}

fn image_without_close(before: i64) -> LocalPid<magick.Image> {
    let image = spawn magick.Image(source: Source.Blank(10, 10, "white"));
    match image.width() {
        .Ok(.Ok(value)) => testing.assert_eq(value as i64, 10),
        _ => testing.assert_true(false),
    }
    testing.assert_eq(unsafe {
        hew_magick_image_count()
    }, before + 1);
    image
}

fn actor_stop_releases_relative_registry_count() {
    let before = unsafe {
        hew_magick_image_count()
    };
    testing.assert_true(before >= 0);
    let image = image_without_close(before);
    close(image);
    var attempts = 0;
    while unsafe {
        hew_magick_image_count()
    } != before && attempts < 100 {
        sleep(5ms);
        attempts = attempts + 1;
    }
    testing.assert_eq(unsafe {
        hew_magick_image_count()
    }, before);
}

fn main() {
    transformations_cover_public_surface();
    long_unicode_path_round_trips_a_written_image();
    missing_file_error_carries_the_path();
    invalid_inputs_return_typed_errors();
    blob_round_trip_preserves_a_real_image();
    actor_stop_releases_relative_registry_count();
}
