# Toolchain pins for checking and publishing these packages. The workflows load
# this file into $GITHUB_ENV and the Makefile includes it. The compatible native
# hew-cabi dependency is pinned separately in Cargo.toml and Cargo.lock.
#
#   HEW_REVISION       hew commit the packages are checked and published against
#   HEW_VERSION        version string that commit's binary must report
#   LLVM_VERSION       LLVM release that commit's build needs
HEW_REVISION=98b6884ba510b8b5c3211daa34708928af6030ce
HEW_VERSION=0.10.0-rc1-dev.310+98b6884ba5
LLVM_VERSION=22.1.5
