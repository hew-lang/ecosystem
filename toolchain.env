# Toolchain pins for checking and publishing these packages. The workflows load
# this file into $GITHUB_ENV and the Makefile includes it. The one hand-written
# copy of HEW_REVISION elsewhere is the hew-cabi `rev` in Cargo.toml, which
# Cargo requires as a literal.
#
#   HEW_REVISION       hew commit the packages are checked and published against
#   HEW_VERSION        version string that commit's binary must report
#   LLVM_VERSION       LLVM release that commit's build needs
HEW_REVISION=17e06579cb14a167be1e369bdda5388e14e95f80
HEW_VERSION=0.9.1
LLVM_VERSION=22.1.5
