# Toolchain and registry pins for checking and publishing these packages. The
# workflows load this file into $GITHUB_ENV, the Makefile includes it, and
# scripts/publish-packages.sh sources it. The one hand-written copy of
# HEW_REVISION elsewhere is the hew-cabi `rev` in Cargo.toml, which Cargo
# requires as a literal.
#
#   HEW_REVISION       hew commit the packages are checked and published against
#   HEW_VERSION        version string that commit's binary must report
#   LLVM_VERSION       LLVM release that commit's build needs
#   REGISTRY_API       registry endpoint scripts/publish-packages.sh publishes to
#   REGISTRY_AUDIENCE  OIDC audience for trusted publishing
# shellcheck disable=SC2034
HEW_REVISION=6a446f773391f45d2c0ce0a799240b8b9afef54e
HEW_VERSION=0.6.1
LLVM_VERSION=22.1.5
REGISTRY_API=https://registry.hewpkg.com/api/v1
REGISTRY_AUDIENCE=https://registry.hewpkg.com
