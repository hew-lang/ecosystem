//! End-to-end coverage for the public `hew.auth.oauth` API.
//!
//! Token requests go to a loopback `std.net.http` server owned by this
//! program: the OAuth call runs in a fork while the main thread accepts the
//! request, records it, and answers with a canned status and body.

import hew.auth.oauth;

import std.crypto.crypto;

import std.encoding.base64;

import std.net.http;

import std.net.http.http_client;

// What the token endpoint received.
type Received {
    method: string;
    content_type: string;
    form: string;
}

fn listen() -> http.Server {
    match http.listen("127.0.0.1:0") {
        .Ok(server) => server,
        .Err(_) => panic(f"loopback listen failed: {http.listen_error()}"),
    }
}

fn token_url(server: http.Server) -> string {
    f"http://127.0.0.1:{http.server_port(server)}/token"
}

fn answer(server: http.Server, status: i64, body: string) -> Received {
    let req = server.accept();
    let received = Received { method: req.method(), content_type: req.header("Content-Type"), form: req.body("utf-8") };
    match req.respond(status, "application/json", body) {
        .Ok(_) => {}
        .Err(_) => panic("loopback respond failed"),
    }
    req.close();
    received
}

fn expect_token(reply: Result<Result<oauth.Token, oauth.OAuthError>, ActorError>) -> oauth.Token {
    match reply {
        .Ok(result) => match result {
            .Ok(token) => token,
            .Err(error) => panic(f"expected a token, got: {oauth.error_message(error)}"),
        }
        .Err(_) => panic("OAuth actor stopped before replying"),
    }
}

fn expect_endpoint_error(reply: Result<Result<oauth.Token, oauth.OAuthError>, ActorError>, status: i64, message: string) {
    match reply {
        .Ok(result) => match result {
            .Err(.TokenEndpoint(got_status, got_message)) => {
                assert(got_status == status);
                assert(got_message == message);
            }
            _ => panic("expected a token-endpoint error"),
        }
        .Err(_) => panic("OAuth actor stopped before replying"),
    }
}

fn expect_invalid_input(reply: Result<Result<oauth.Token, oauth.OAuthError>, ActorError>, message: string) {
    match reply {
        .Ok(result) => match result {
            .Err(.InvalidInput(got)) => assert(got == message),
            _ => panic("expected an InvalidInput error"),
        }
        .Err(_) => panic("OAuth actor stopped before replying"),
    }
}

fn new_client() -> oauth.Client {
    spawn oauth.Client { client_id: "client", client_secret: "s3cret&more" }
}

fn finish(client: oauth.Client) {
    stop(client);
    stopped(client);
}

fn client_credentials_posts_form_and_reads_every_token_field() {
    let server = listen();
    let client = new_client();
    let pending = fork client.client_credentials(token_url(server), "read ü");
    let received = answer(server, 200, "{\"access_token\":\"access-1\",\"token_type\":\"mac\",\"expires_in\":3600,\"refresh_token\":\"refresh-1\",\"scope\":\"read\"}");
    server.close();
    let token = expect_token(await pending);
    assert(received.method == "POST");
    assert(received.content_type == "application/x-www-form-urlencoded");
    assert(received.form == "grant_type=client_credentials&client_id=client&client_secret=s3cret%26more&scope=read%20%C3%BC");
    assert(token.access_token() == "access-1");
    assert(token.token_type() == "mac");
    match token.expires_in() {
        .Some(seconds) => assert(seconds == 3600),
        .None => panic("expected expires_in"),
    }
    match token.refresh_token() {
        .Some(value) => assert(value == "refresh-1"),
        .None => panic("expected a refresh token"),
    }
    match token.get_scope() {
        .Some(value) => assert(value == "read"),
        .None => panic("expected a scope"),
    }
    finish(client);
}

fn client_credentials_without_scope_omits_it_and_defaults_optional_fields() {
    let server = listen();
    let client = new_client();
    let pending = fork client.client_credentials(token_url(server), "");
    let received = answer(server, 200, "{\"access_token\":\"bare\"}");
    server.close();
    let token = expect_token(await pending);
    assert(!received.form.contains("scope="));
    assert(token.access_token() == "bare");
    assert(token.token_type() == "Bearer");
    assert(token.expires_in().is_none());
    assert(token.refresh_token().is_none());
    assert(token.get_scope().is_none());
    finish(client);
}

fn rejected_request_reports_status_and_endpoint_error() {
    let server = listen();
    let client = new_client();
    let pending = fork client.client_credentials(token_url(server), "");
    let _ = answer(server, 400, "{\"error\":\"invalid_client\",\"error_description\":\"bad credentials\"}");
    server.close();
    expect_endpoint_error(await pending, 400, "invalid_client: bad credentials");
    finish(client);
}

fn success_status_with_oauth_error_body_is_rejected() {
    let server = listen();
    let client = new_client();
    let pending = fork client.client_credentials(token_url(server), "");
    let _ = answer(server, 200, "{\"error\":\"slow_down\"}");
    server.close();
    expect_endpoint_error(await pending, 200, "slow_down");
    finish(client);
}

fn non_json_body_reports_invalid_json() {
    let server = listen();
    let client = new_client();
    let pending = fork client.client_credentials(token_url(server), "");
    let _ = answer(server, 200, "<html>not a token</html>");
    server.close();
    match await pending {
        .Ok(result) => match result {
            .Err(.TokenEndpoint(status, message)) => {
                assert(status == 200);
                assert(message.starts_with("invalid_json: "));
            }
            _ => panic("expected a token-endpoint error"),
        }
        .Err(_) => panic("OAuth actor stopped before replying"),
    }
    finish(client);
}

fn missing_access_token_is_rejected() {
    let server = listen();
    let client = new_client();
    let pending = fork client.client_credentials(token_url(server), "");
    let _ = answer(server, 200, "{\"token_type\":\"Bearer\"}");
    server.close();
    expect_endpoint_error(await pending, 200, "missing access_token in token response");
    finish(client);
}

fn refused_connection_reports_transport_error() {
    // Bind and release a port so nothing is listening on it.
    let server = listen();
    let url = token_url(server);
    server.close();
    let client = new_client();
    match client.client_credentials(url, "") {
        .Ok(result) => match result {
            .Err(.Transport(message)) => assert(message.starts_with("transport_error: ") && message.len() > 17),
            _ => panic("expected a transport error"),
        }
        .Err(_) => panic("OAuth actor stopped before replying"),
    }
    finish(client);
}

fn exchange_code_sends_the_verifier_auth_url_committed_to() {
    let server = listen();
    let client = new_client();
    let url = match client.auth_url("https://authorization.example/authorize", "https://app.example/callback", "", "caller-state") {
        .Ok(.Ok(value)) => value,
        _ => panic("expected an authorization URL"),
    };
    let verifier = match client.current_code_verifier() {
        .Ok(.Ok(.Some(value))) => value,
        _ => panic("expected auth_url to retain a PKCE verifier"),
    };
    // RFC 7636: 43 unpadded base64url characters, and the URL carries the
    // S256 challenge of exactly the verifier the exchange will send.
    assert(verifier.len() == 43);
    assert(!verifier.contains("="));
    let challenge = base64.encode_url(crypto.sha256(verifier.to_bytes())).replace("=", "");
    assert(url.contains(f"&code_challenge={challenge}&code_challenge_method=S256"));
    let pending = fork client.exchange_code(token_url(server), "code 123", "https://app.example/callback");
    let received = answer(server, 200, "{\"access_token\":\"exchanged\"}");
    server.close();
    let token = expect_token(await pending);
    assert(token.access_token() == "exchanged");
    assert(received.form == f"grant_type=authorization_code&code=code%20123&redirect_uri=https%3A%2F%2Fapp.example%2Fcallback&client_id=client&client_secret=s3cret%26more&code_verifier={verifier}");
    finish(client);
}

fn exchange_code_with_verifier_sends_the_supplied_verifier() {
    let server = listen();
    let client = new_client();
    let pending = fork client.exchange_code_with_verifier(token_url(server), "abc", "https://app.example/cb", "stored-verifier");
    let received = answer(server, 200, "{\"access_token\":\"exchanged\"}");
    server.close();
    let _ = expect_token(await pending);
    assert(received.form.starts_with("grant_type=authorization_code&code=abc&"));
    assert(received.form.ends_with("&code_verifier=stored-verifier"));
    finish(client);
}

fn refresh_posts_refresh_grant() {
    let server = listen();
    let client = new_client();
    let pending = fork client.refresh(token_url(server), "refresh token");
    let received = answer(server, 200, "{\"access_token\":\"new-access\",\"refresh_token\":\"next\"}");
    server.close();
    let token = expect_token(await pending);
    assert(received.form == "grant_type=refresh_token&refresh_token=refresh%20token&client_id=client&client_secret=s3cret%26more");
    assert(token.access_token() == "new-access");
    match token.refresh_token() {
        .Some(value) => assert(value == "next"),
        .None => panic("expected the rotated refresh token"),
    }
    finish(client);
}

// Each of these is refused before any request is sent.
fn local_preconditions_return_invalid_input() {
    let client = new_client();
    expect_invalid_input(client.exchange_code("http://127.0.0.1:9/token", "code", "https://app.example/cb"), "missing_code_verifier: call auth_url before exchange_code or use exchange_code_with_verifier");
    expect_invalid_input(client.exchange_code_with_verifier("http://127.0.0.1:9/token", "code", "https://app.example/cb", ""), "PKCE verifier must not be empty");
    expect_invalid_input(client.refresh("http://127.0.0.1:9/token", ""), "refresh token must not be empty");
    expect_invalid_input(client.client_credentials("", ""), "token URL must not be empty");
    match client.validate_state("") {
        .Ok(.Err(.InvalidInput(message))) => assert(message == "callback state must not be empty"),
        _ => panic("expected an InvalidInput error for an empty callback state"),
    }
    match client.auth_url("", "https://app.example/cb", "", "") {
        .Ok(.Err(.InvalidInput(_))) => {}
        _ => panic("expected an InvalidInput error for an empty authorization URL"),
    }
    finish(client);
}

fn fresh_client_has_no_state_and_matches_nothing() {
    let client = new_client();
    match client.current_state() {
        .Ok(.Ok(.None)) => {}
        _ => panic("expected a fresh client with no state"),
    }
    match client.current_code_verifier() {
        .Ok(.Ok(.None)) => {}
        _ => panic("expected a fresh client with no verifier"),
    }
    match client.validate_state("anything") {
        .Ok(.Ok(matched)) => assert(!matched),
        _ => panic("expected a fresh client to reject every state"),
    }
    finish(client);
}

// The authorization URL is built entirely in process: long non-ASCII values
// and an embedded NUL are percent-encoded byte for byte, and the caller's
// state is retained.
fn auth_url_encodes_non_ascii_and_nul_values() {
    let client = spawn oauth.Client { client_id: "identité\0du-client-2026", client_secret: "secret" };
    let url = match client.auth_url("https://authorization.example/authorize", "https://app.example/callback", "lecture écriture profil élargi", "état-de-rappel-vérifié-42") {
        .Ok(.Ok(value)) => value,
        _ => panic("expected an authorization URL"),
    };
    assert(url.starts_with("https://authorization.example/authorize?response_type=code&"));
    assert(url.contains("client_id=identit%C3%A9%00du-client-2026"));
    assert(url.contains("scope=lecture%20%C3%A9criture%20profil%20%C3%A9largi"));
    assert(url.contains("state=%C3%A9tat-de-rappel-v%C3%A9rifi%C3%A9-42"));
    assert(url.contains("redirect_uri=https%3A%2F%2Fapp.example%2Fcallback"));
    match client.current_state() {
        .Ok(.Ok(.Some(value))) => assert(value == "état-de-rappel-vérifié-42"),
        _ => panic("expected auth_url to retain the caller's state"),
    }
    finish(client);
}

fn generated_state_validates_and_each_auth_url_rotates_it() {
    let client = new_client();
    let url = match client.auth_url("https://authorization.example/authorize", "https://app.example/callback", "profile", "") {
        .Ok(.Ok(value)) => value,
        _ => panic("expected an authorization URL"),
    };
    let state = match client.current_state() {
        .Ok(.Ok(.Some(value))) => value,
        _ => panic("expected auth_url to retain a state value"),
    };
    assert(state.len() == 43);
    assert(url.contains(f"&state={state}&"));
    match client.validate_state(state) {
        .Ok(.Ok(matched)) => assert(matched),
        _ => panic("expected the retained state to validate"),
    }
    match client.validate_state("a state this client never issued") {
        .Ok(.Ok(matched)) => assert(!matched),
        _ => panic("expected a mismatched state to be rejected, not to error"),
    }
    let _ = client.auth_url("https://authorization.example/authorize", "https://app.example/callback", "profile", "");
    match client.validate_state(state) {
        .Ok(.Ok(matched)) => assert(!matched),
        _ => panic("expected the previous state to be replaced"),
    }
    finish(client);
}

fn main() {
    // A broken loopback exchange fails within seconds rather than at the
    // client's 30 s default.
    match http_client.set_timeout(5000) {
        .Ok(_) => {}
        .Err(_) => panic("set_timeout rejected 5000 ms"),
    }
    client_credentials_posts_form_and_reads_every_token_field();
    client_credentials_without_scope_omits_it_and_defaults_optional_fields();
    rejected_request_reports_status_and_endpoint_error();
    success_status_with_oauth_error_body_is_rejected();
    non_json_body_reports_invalid_json();
    missing_access_token_is_rejected();
    refused_connection_reports_transport_error();
    exchange_code_sends_the_verifier_auth_url_committed_to();
    exchange_code_with_verifier_sends_the_supplied_verifier();
    refresh_posts_refresh_grant();
    local_preconditions_return_invalid_input();
    fresh_client_has_no_state_and_matches_nothing();
    auth_url_encodes_non_ascii_and_nul_values();
    generated_state_validates_and_each_auth_url_rotates_it();
    println("oauth public API: ok");
}
