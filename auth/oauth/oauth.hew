//! OAuth 2.0 client for authentication and authorization flows.
//!
//! Supports client credentials (machine-to-machine), PKCE-protected
//! authorization code URL generation, token exchange, and token refresh.
//! Token requests are form-encoded POSTs sent with `std.net.http.http_client`.
//!
//! # Examples
//!
//! ```
//! import hew.auth.oauth;
//!
//! fn main() {
//!     // Machine-to-machine: get a token using client credentials
//!     let client = spawn oauth.Client { client_id: "my-service", client_secret: "secret123" };
//!
//!     let token = match client.client_credentials("https://auth.example.com/token", "read write") {
//!         .Ok(value) => value,
//!         .Err(.Failed(error)) => panic(oauth.error_message(error)),
//!         .Err(_) => panic("OAuth actor stopped"),
//!     };
//!     println(token.access_token());
//!
//!     // Authorization code: generate a PKCE-protected redirect URL for user login.
//!     // Passing empty state makes the client generate a CSPRNG state.
//!     let url = match client.auth_url("https://auth.example.com/authorize", "https://myapp.com/callback", "openid profile", "") {
//!         .Ok(value) => value,
//!         .Err(.Failed(error)) => panic(oauth.error_message(error)),
//!         .Err(_) => panic("OAuth actor stopped"),
//!     };
//!     println(url);
//!
//!     // Compare the callback `state` with validate_state, then exchange the
//!     // code; the stored PKCE verifier is sent with it.
//!     let token2 = match client.exchange_code("https://auth.example.com/token", "auth-code-from-redirect", "https://myapp.com/callback") {
//!         .Ok(value) => value,
//!         .Err(.Failed(error)) => panic(oauth.error_message(error)),
//!         .Err(_) => panic("OAuth actor stopped"),
//!     };
//!     println(token2.token_type());
//!     stop(client);
//!     stopped(client);
//! }
//! ```

import std.crypto.crypto;

import std.encoding.base64;

import std.encoding.json;

import std.net.http.http_client;

import std.net.url;

/// A token issued by an authorization server. Read it through
/// `TokenMethods`; absent optional values are stored as -1 or empty strings.
#[wire]
pub type Token {
    access: string @1;
    kind: string @2;
    expires_secs: i64 @3;
    refresh: string @4;
    granted_scope: string @5;
}

#[wire]
pub enum OAuthError {
    /// A required URL, code, verifier, or credential was invalid.
    InvalidInput(string) @0;
    /// The authorization server could not be reached.
    Transport(string) @1;
    /// The token endpoint rejected the request or returned an invalid body.
    TokenEndpoint(i64, string) @2;
    /// The client could not complete the operation locally, such as when the
    /// system entropy source is unavailable.
    Internal(string) @3;
}

/// Return the diagnostic carried by an `OAuthError`.
pub fn error_message(error: OAuthError) -> string {
    match error {
        .InvalidInput(message) => message,
        .Transport(message) => message,
        .TokenEndpoint(_, message) => message,
        .Internal(message) => message,
    }
}

// ── Token methods ─────────────────────────────────────────────────────
trait TokenMethods {
    /// The access token string.
    fn access_token(self) -> string;

    /// Token type (usually "Bearer").
    fn token_type(self) -> string;

    /// Expiry in seconds from issuance, when provided.
    fn expires_in(self) -> Option<i64>;

    /// Refresh token, when provided.
    fn refresh_token(self) -> Option<string>;

    /// Token scope, when provided.
    fn get_scope(self) -> Option<string>;
}

impl TokenMethods for Token {
    fn access_token(self) -> string {
        self.access
    }
    fn token_type(self) -> string {
        self.kind
    }
    fn expires_in(self) -> Option<i64> {
        if self.expires_secs < 0 {
            .None
        } else {
            .Some(self.expires_secs)
        }
    }
    fn refresh_token(self) -> Option<string> {
        present(self.refresh)
    }
    fn get_scope(self) -> Option<string> {
        present(self.granted_scope)
    }
}

fn present(value: string) -> Option<string> {
    if value.is_empty() {
        .None
    } else {
        .Some(value)
    }
}

// ── PKCE and state values ─────────────────────────────────────────────
// Unpadded base64url (RFC 4648 §5), the alphabet RFC 7636 requires for the
// verifier and challenge. `=` appears only as padding, so removing it is exact.
fn base64url_unpadded(data: bytes) -> string {
    base64.encode_url(data).replace("=", "")
}

// 32 CSPRNG bytes encode to 43 characters: a state value, or a verifier at the
// lower bound of RFC 7636's 43..128 range.
fn random_urlsafe() -> Result<string, OAuthError> {
    match crypto.random_bytes(32) {
        .Ok(data) => .Ok(base64url_unpadded(data)),
        .Err(_) => .Err(OAuthError.Internal("system entropy source is unavailable")),
    }
}

// The S256 code challenge for a verifier (RFC 7636 §4.2).
fn code_challenge(verifier: string) -> string {
    base64url_unpadded(crypto.sha256(verifier.to_bytes()))
}

// ── Token endpoint ────────────────────────────────────────────────────
// A string field of a JSON object. A missing field, a field of another kind,
// and a body that is not an object all read as absent.
fn string_field(body: json.Value, key: string) -> Option<string> {
    match body.get_field(key) {
        .Ok(.Some(value)) => match value.get_string() {
            .Ok(text) => .Some(text),
            .Err(_) => .None,
        }
        _ => .None,
    }
}

fn string_field_or(body: json.Value, key: string, fallback: string) -> string {
    match string_field(body, key) {
        .Some(text) => text,
        .None => fallback,
    }
}

// An integer field, or -1 when it is missing or not an integer.
fn int_field_or_absent(body: json.Value, key: string) -> i64 {
    match body.get_field(key) {
        .Ok(.Some(value)) => match value.get_int() {
            .Ok(number) => number,
            .Err(_) => -1,
        }
        _ => -1,
    }
}

// The RFC 6749 §5.2 error, as `error` or `error: error_description`.
fn endpoint_message(body: json.Value, fallback: string) -> string {
    match string_field(body, "error") {
        .None => fallback,
        .Some(code) => match string_field(body, "error_description") {
            .Some(description) => if description.is_empty() {
                code
            } else {
                f"{code}: {description}"
            }
            .None => code,
        }
    }
}

fn parse_token(status: i64, text: string) -> Result<Token, OAuthError> {
    let body = match json.parse(text) {
        .Ok(value) => value,
        .Err(error) => return .Err(OAuthError.TokenEndpoint(status, f"invalid_json: {error}")),
    };
    if status < 200 || status >= 300 {
        return .Err(OAuthError.TokenEndpoint(status, endpoint_message(body, "http_error")));
    }
    if string_field(body, "error").is_some() {
        return .Err(OAuthError.TokenEndpoint(status, endpoint_message(body, "oauth_error")));
    }
    let access = match string_field(body, "access_token") {
        .Some(value) => value,
        .None => return .Err(OAuthError.TokenEndpoint(status, "missing access_token in token response")),
    };
    .Ok(Token { access: access, kind: string_field_or(body, "token_type", "Bearer"), expires_secs: int_field_or_absent(body, "expires_in"), refresh: string_field_or(body, "refresh_token", ""), granted_scope: string_field_or(body, "scope", "") })
}

// POST a form-encoded grant. A status of -1 is a transport failure, and the
// client then carries its diagnostic in the body.
fn post_token(token_url: string, form: string) -> Result<Token, OAuthError> {
    if token_url.is_empty() {
        return .Err(OAuthError.InvalidInput("token URL must not be empty"));
    }
    var headers: Vec<(string, string)> = Vec.new();
    headers.push(("Content-Type", "application/x-www-form-urlencoded"));
    let response = http_client.request("POST", token_url, form, headers);
    let status = response.status();
    let text = response.body();
    response.close();
    if status < 0 {
        return .Err(OAuthError.Transport(f"transport_error: {text}"));
    }
    parse_token(status, text)
}

fn authorization_code_form(code: string, redirect_uri: string, client_id: string, client_secret: string, code_verifier: string) -> string {
    f"grant_type=authorization_code&code={url.encode(code)}&redirect_uri={url.encode(redirect_uri)}&client_id={url.encode(client_id)}&client_secret={url.encode(client_secret)}&code_verifier={url.encode(code_verifier)}"
}

// ── Actor ─────────────────────────────────────────────────────────────
pub actor Client {
    let client_id: string;
    let client_secret: string;
    var pending_state: string = "";
    var pending_code_verifier: string = "";

    // Obtain a token using the client credentials grant. oauth_scope may be
    // empty, in which case no scope is requested.
    receive fn client_credentials(token_url: string, oauth_scope: string) -> Token fails OAuthError {
        var form = f"grant_type=client_credentials&client_id={url.encode(client_id)}&client_secret={url.encode(client_secret)}";
        if !oauth_scope.is_empty() {
            form = form + f"&scope={url.encode(oauth_scope)}";
        }
        post_token(token_url, form)?
    }

    // Generate an authorization URL for the authorization code grant.
    // Always includes PKCE S256 parameters. If state is empty, a CSPRNG state is
    // generated. The state and PKCE verifier are retained on this client.
    receive fn auth_url(auth_url: string, redirect_uri: string, oauth_scope: string, state: string) -> string fails OAuthError {
        if auth_url.is_empty() || redirect_uri.is_empty() {
            return error OAuthError.InvalidInput("authorization and redirect URLs must not be empty");
        }
        let chosen_state = if state.is_empty() {
            random_urlsafe()?
        } else {
            state
        };
        let verifier = random_urlsafe()?;
        pending_state = chosen_state;
        pending_code_verifier = verifier;
        f"{auth_url}?response_type=code&client_id={url.encode(client_id)}&redirect_uri={url.encode(redirect_uri)}&scope={url.encode(oauth_scope)}&state={url.encode(chosen_state)}&code_challenge={code_challenge(verifier)}&code_challenge_method=S256"
    }

    // Return the current authorization-code state generated or accepted by auth_url.
    receive fn current_state() -> Option<string> {
        present(pending_state)
    }

    // Return the current PKCE code verifier for external encrypted/session storage.
    receive fn current_code_verifier() -> Option<string> {
        present(pending_code_verifier)
    }

    // Validate a callback state against the current state in constant time.
    // A client with no current state matches nothing.
    receive fn validate_state(callback_state: string) -> bool fails OAuthError {
        if callback_state.is_empty() {
            return error OAuthError.InvalidInput("callback state must not be empty");
        }
        !pending_state.is_empty() && crypto.constant_time_eq(pending_state.to_bytes(), callback_state.to_bytes())
    }

    // Exchange an authorization code for a token using the verifier from auth_url.
    receive fn exchange_code(token_url: string, code: string, redirect_uri: string) -> Token fails OAuthError {
        if pending_code_verifier.is_empty() {
            return error OAuthError.InvalidInput("missing_code_verifier: call auth_url before exchange_code or use exchange_code_with_verifier");
        }
        post_token(token_url, authorization_code_form(code, redirect_uri, client_id, client_secret, pending_code_verifier))?
    }

    // Exchange an authorization code with an explicitly supplied PKCE verifier.
    receive fn exchange_code_with_verifier(token_url: string, code: string, redirect_uri: string, code_verifier: string) -> Token fails OAuthError {
        if code_verifier.is_empty() {
            return error OAuthError.InvalidInput("PKCE verifier must not be empty");
        }
        post_token(token_url, authorization_code_form(code, redirect_uri, client_id, client_secret, code_verifier))?
    }

    // Refresh a token using a refresh token string.
    receive fn refresh(token_url: string, refresh_token: string) -> Token fails OAuthError {
        if refresh_token.is_empty() {
            return error OAuthError.InvalidInput("refresh token must not be empty");
        }
        post_token(token_url, f"grant_type=refresh_token&refresh_token={url.encode(refresh_token)}&client_id={url.encode(client_id)}&client_secret={url.encode(client_secret)}")?
    }
}

#[test]
fn code_challenge_matches_rfc_7636_appendix_b() {
    assert(code_challenge("dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk") == "E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM");
}

#[test]
fn generated_values_are_unpadded_43_character_base64url() {
    let value = match random_urlsafe() {
        .Ok(value) => value,
        .Err(error) => panic(error_message(error)),
    };
    assert(value.len() == 43);
    assert(!value.contains("="));
    assert(!value.contains("+"));
    assert(!value.contains("/"));
}

#[test]
fn token_body_defaults_absent_and_wrong_kind_fields() {
    let token = match parse_token(200, "{\"access_token\":\"abc\",\"expires_in\":\"soon\",\"token_type\":7}") {
        .Ok(token) => token,
        .Err(error) => panic(error_message(error)),
    };
    assert(token.access_token() == "abc");
    assert(token.token_type() == "Bearer");
    assert(token.expires_in().is_none());
    assert(token.refresh_token().is_none());
    assert(token.get_scope().is_none());
}

#[test]
fn endpoint_error_without_description_reports_the_code() {
    match parse_token(401, "{\"error\":\"invalid_client\",\"error_description\":\"\"}") {
        .Err(.TokenEndpoint(status, message)) => {
            assert(status == 401);
            assert(message == "invalid_client");
        }
        _ => panic("expected a token-endpoint error"),
    }
    match parse_token(502, "[]") {
        .Err(.TokenEndpoint(status, message)) => {
            assert(status == 502);
            assert(message == "http_error");
        }
        _ => panic("expected a token-endpoint error"),
    }
}
